<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FarmaCerta - Recibos</title>

    <link rel="stylesheet" href="../style.css">
    <link rel="icon" type="image/png" href="../assets/LOGO_2.png">
</head>

<body>

    <!-- =====================================================
         TOPO
    ====================================================== -->

    <header class="topo">

        <img
            src="../assets/LOGO_1.png"
            alt="Foto da empresa"
            width="200"
            height="auto"
        >

        <h1>FarmaCerta - Gerente</h1>

        <div class="usuario-topo">
            <span>Gerente: farmacia1</span>

            <a class="logout" href="../index.html">
                SAIR
            </a>
        </div>

    </header>


    <!-- =====================================================
         MENU
    ====================================================== -->

    <nav class="menu">

        <a href="iniciogerente.html">
            INÍCIO
        </a>

        <a href="cadastrargerente.html">
            CADASTRAR PRODUTO
        </a>

        <a href="historicorecibogerente.html" class="ativo">
            RECIBOS
        </a>

    </nav>


    <!-- =====================================================
         CONTEÚDO
    ====================================================== -->

    <main class="container">

        <!-- =================================================
             CARD DE FILTROS
        ================================================== -->

        <div class="card">

            <h2>RECIBOS</h2>

            <!-- =============================================
                 FILTRO DE DATA
            ============================================== -->

            <label for="opcao">
                Mostrar
            </label>

            <div class="select-custom" id="select-opcao">

                <button
                    type="button"
                    class="select-button"
                    id="botao-opcao"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                >
                    <span class="texto-select" id="texto-opcao">
                        Recibos do dia
                    </span>

                    <span class="seta-select">
                        ▼
                    </span>
                </button>

                <div
                    class="select-lista"
                    id="lista-opcao"
                    role="listbox"
                >

                    <div
                        class="opcao-select"
                        data-value="dia"
                        role="option"
                        aria-selected="true"
                    >
                        Recibos do dia
                    </div>

                    <div
                        class="opcao-select"
                        data-value="todos"
                        role="option"
                        aria-selected="false"
                    >
                        Todos os recibos
                    </div>

                </div>

            </div>


            <!-- =============================================
                 FILTRO DE PAGAMENTO
            ============================================== -->

            <label for="pagamento">
                Forma de pagamento
            </label>

            <div class="select-custom" id="select-pagamento">

                <button
                    type="button"
                    class="select-button"
                    id="botao-pagamento"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                >
                    <span class="texto-select" id="texto-pagamento">
                        Todas as formas de pagamento
                    </span>

                    <span class="seta-select">
                        ▼
                    </span>
                </button>

                <div
                    class="select-lista"
                    id="lista-pagamento"
                    role="listbox"
                >

                    <div
                        class="opcao-select"
                        data-value="todos"
                        role="option"
                        aria-selected="true"
                    >
                        Todas as formas de pagamento
                    </div>

                    <div
                        class="opcao-select"
                        data-value="pix"
                        role="option"
                        aria-selected="false"
                    >
                        PIX
                    </div>

                    <div
                        class="opcao-select"
                        data-value="cartao"
                        role="option"
                        aria-selected="false"
                    >
                        Cartão
                    </div>

                    <div
                        class="opcao-select"
                        data-value="dinheiro"
                        role="option"
                        aria-selected="false"
                    >
                        Dinheiro
                    </div>

                </div>

            </div>


            <!-- Valores utilizados pelo JavaScript -->

            <input
                type="hidden"
                id="opcao"
                value="dia"
            >

            <input
                type="hidden"
                id="pagamento"
                value="todos"
            >

        </div>


        <!-- =================================================
             TABELA DE RECIBOS
        ================================================== -->

        <section class="secao-branca">

            <h2 id="titulo">
                RECIBOS DO DIA
            </h2>

            <div class="tabela-wrapper">

                <table class="tabela">

                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Data</th>
                            <th>Cliente</th>
                            <th>Pagamento</th>
                            <th>Valor</th>
                        </tr>
                    </thead>

                    <tbody>

                        <!-- RECIBO 0037 -->

                        <tr
                            id="recibo-0037"
                            data-data="dia"
                            data-pagamento="pix"
                        >
                            <td>#0037</td>
                            <td>19/08/2026</td>
                            <td>João da Silva</td>
                            <td>PIX</td>
                            <td>R$ 33,90</td>
                        </tr>


                        <!-- RECIBO 0036 -->

                        <tr
                            id="recibo-0036"
                            data-data="dia"
                            data-pagamento="cartao"
                        >
                            <td>#0036</td>
                            <td>19/08/2026</td>
                            <td>Maria Alves</td>
                            <td>Cartão</td>
                            <td>R$ 86,50</td>
                        </tr>


                        <!-- RECIBO 0035 -->

                        <tr
                            id="recibo-0035"
                            data-data="antigo"
                            data-pagamento="dinheiro"
                        >
                            <td>#0035</td>
                            <td>18/08/2026</td>
                            <td>Carlos Mendes</td>
                            <td>Dinheiro</td>
                            <td>R$ 45,80</td>
                        </tr>


                        <!-- RECIBO 0034 -->

                        <tr
                            id="recibo-0034"
                            data-data="antigo"
                            data-pagamento="pix"
                        >
                            <td>#0034</td>
                            <td>17/08/2026</td>
                            <td>Fernanda Silva</td>
                            <td>PIX</td>
                            <td>R$ 72,40</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </main>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>

        /*
        ======================================================
        SELECT PERSONALIZADO
        ======================================================
        */

        const selects = document.querySelectorAll(".select-custom");


        /*
        ======================================================
        FECHAR SELECTS
        ======================================================
        */

        function fecharSelects() {

            document
                .querySelectorAll(".select-lista.abrir")
                .forEach(lista => {

                    lista.classList.remove("abrir");

                });


            document
                .querySelectorAll(
                    ".select-button[aria-expanded='true']"
                )
                .forEach(botao => {

                    botao.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                });

        }


        /*
        ======================================================
        CONFIGURAR SELECT
        ======================================================
        */

        function configurarSelect(select) {

            const botao =
                select.querySelector(".select-button");

            const lista =
                select.querySelector(".select-lista");

            const texto =
                select.querySelector(".texto-select");

            const opcoes =
                select.querySelectorAll(".opcao-select");


            /*
            --------------------------------------------------
            IDENTIFICA QUAL CAMPO HIDDEN O SELECT CONTROLA
            --------------------------------------------------
            */

            const hiddenId =
                select.id === "select-opcao"
                    ? "opcao"
                    : "pagamento";


            const hidden =
                document.getElementById(hiddenId);


            /*
            --------------------------------------------------
            ABRIR / FECHAR
            --------------------------------------------------
            */

            botao.addEventListener(
                "click",
                function (event) {

                    event.stopPropagation();

                    const estavaAberto =
                        lista.classList.contains("abrir");

                    fecharSelects();

                    if (!estavaAberto) {

                        lista.classList.add("abrir");

                        botao.setAttribute(
                            "aria-expanded",
                            "true"
                        );

                    }

                }
            );


            /*
            --------------------------------------------------
            SELECIONAR OPÇÃO
            --------------------------------------------------
            */

            opcoes.forEach(opcao => {

                opcao.addEventListener(
                    "click",
                    function (event) {

                        event.stopPropagation();


                        const valor =
                            opcao.dataset.value;


                        const textoSelecionado =
                            opcao.textContent.trim();


                        /*
                        Atualiza o valor hidden
                        */

                        hidden.value = valor;


                        /*
                        Atualiza o texto do botão
                        */

                        texto.textContent =
                            textoSelecionado;


                        /*
                        Atualiza aria-selected
                        */

                        opcoes.forEach(item => {

                            item.setAttribute(
                                "aria-selected",
                                item === opcao
                                    ? "true"
                                    : "false"
                            );

                        });


                        /*
                        Fecha a lista
                        */

                        lista.classList.remove("abrir");

                        botao.setAttribute(
                            "aria-expanded",
                            "false"
                        );


                        /*
                        Atualiza os recibos
                        */

                        mudarRecibos();

                    }
                );

            });

        }


        /*
        ======================================================
        INICIALIZA OS SELECTS
        ======================================================
        */

        selects.forEach(configurarSelect);


        /*
        ======================================================
        FECHAR AO CLICAR FORA
        ======================================================
        */

        document.addEventListener(
            "click",
            fecharSelects
        );


        /*
        ======================================================
        MUDAR RECIBOS
        ======================================================
        */

        function mudarRecibos() {

            const opcao =
                document.getElementById("opcao").value;


            const pagamento =
                document.getElementById("pagamento").value;


            const titulo =
                document.getElementById("titulo");


            /*
            --------------------------------------------------
            TÍTULO
            --------------------------------------------------
            */

            if (opcao === "todos") {

                titulo.textContent =
                    "TODOS OS RECIBOS";

            } else {

                titulo.textContent =
                    "RECIBOS DO DIA";

            }


            /*
            --------------------------------------------------
            RECIBOS
            --------------------------------------------------
            */

            document
                .querySelectorAll(".tabela tbody tr")
                .forEach(recibo => {

                    const data =
                        recibo.dataset.data;


                    const tipoPagamento =
                        recibo.dataset.pagamento;


                    /*
                    Verifica a data
                    */

                    const mostrarData =
                        opcao === "todos" ||
                        data === "dia";


                    /*
                    Verifica o pagamento
                    */

                    const mostrarPagamento =
                        pagamento === "todos" ||
                        pagamento === tipoPagamento;


                    /*
                    Exibe ou esconde
                    */

                    if (
                        mostrarData &&
                        mostrarPagamento
                    ) {

                        recibo.style.display =
                            "table-row";

                    } else {

                        recibo.style.display =
                            "none";

                    }

                });

        }


        /*
        ======================================================
        INICIALIZAÇÃO
        ======================================================
        */

        mudarRecibos();

    </script>

</body>

</html>
